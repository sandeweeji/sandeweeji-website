generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Badge {
  popular
  new
  spicy
  meal
  bestseller
  limited
}

enum ExtraType {
  ADD
  REMOVE
}

// ----------------------------------------------------------------------------
// Menu
// ----------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  nameEn    String?
  nameAr    String
  emoji     String
  // Used for CATEGORIES.filter(c => c.visible) in menu-page.tsx
  visible   Boolean  @default(true)
  // Controls tab order in the sticky category nav
  sortOrder Int      @default(0)

  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id            String   @id @default(cuid())

  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  nameEn        String?
  nameAr        String
  descriptionEn String?   @db.Text
  descriptionAr String   @db.Text

  price         Decimal  @db.Decimal(10, 2)
  image         String
  // Optional — product-card.tsx / product-modal.tsx only render it when present
  calories      Int?

  badges        Badge[]
  // Drives the greyed-out / "Unavailable" card state in product-card.tsx
  // and the ToggleRight/ToggleLeft switch in the admin table
  available     Boolean  @default(true)
  sortOrder     Int      @default(0)

  extras        Extra[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
  @@map("products")
}

// Per-product modifiers (product.extras in ProductModal) — covers both
// paid add-ons ("extra cheese") and free removable ingredients ("no onions"),
// distinguished by `type`.
model Extra {
  id        String    @id @default(cuid())

  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  type      ExtraType @default(ADD)
  nameEn    String?
  nameAr    String
  // Leave at 0 for REMOVE rows — removing an ingredient doesn't add cost
  price     Decimal   @default(0) @db.Decimal(10, 2)
  sortOrder Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId])
  @@map("extras")
}
